# Copy this file to .env and fill in real values. Never commit a real .env.

# --- Application ---
ENV=dev
APP_NAME=voxmind-api
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Database ---
# Points at the `postgres` service in docker-compose.yml, or your local
# Postgres instance. Must have the pgvector extension installed (the
# `pgvector/pgvector:pg16` image already includes it; Alembic's initial
# migration enables it with CREATE EXTENSION IF NOT EXISTS).
DATABASE_URL=postgresql+asyncpg://voxmind:voxmind@localhost:5432/voxmind

# --- Auth ---
# Required. Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
# Local HTTP dev cannot use Secure+SameSite=None cookies (browsers drop
# them). Set both to their commented defaults only for local development;
# production MUST use COOKIE_SECURE=true and COOKIE_SAMESITE=none (with the
# frontend and API on different subdomains, both served over HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
WS_TICKET_TTL_SECONDS=45

# --- Object storage ---
# "local" writes to the filesystem under STORAGE_LOCAL_ROOT - no external
# service required, good for day-to-day development. "s3" talks to MinIO
# (via docker-compose.yml) or real S3/R2 in production using the same
# boto3-based client code either way.
# STORAGE_LOCAL_ROOT is left unset here deliberately: its default resolves
# to an absolute path anchored to apps/api/ regardless of which directory a
# process is launched from (the API server, a training script, a test
# runner). Only override it with another ABSOLUTE path - a relative one
# reintroduces the exact bug this default was built to avoid (a checkpoint
# saved by a script run from one CWD becoming invisible to a server run
# from another).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=voxmind-audio
S3_ACCESS_KEY=voxmind
S3_SECRET_KEY=voxmind123
S3_REGION=us-east-1

# --- Background jobs (Phase 9) ---
# "in_process" (default through Phase 1-8) runs pipeline stages directly in
# the request's event loop - no Redis/Celery needed. "celery" dispatches
# each stage as a real Celery task through Redis and requires a real Redis
# server plus at least one `celery -A voxmind.workers.celery_app:celery_app
# worker` process running - see docs/celery.md for exact commands.
TASK_RUNNER=in_process
REDIS_URL=redis://localhost:6379/0
# Celery's own result backend (a small completion marker only - real
# pipeline output always lives in Postgres, never here). A different DB
# index than REDIS_URL so broker/result traffic stay independently
# inspectable with redis-cli.
REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1

# --- Rate limiting (core/rate_limit.py) ---
# Protects this API from abuse/runaway expensive requests - not a rate
# limiter for Groq or Hugging Face, and never applied to internal Celery
# task execution. A third logical Redis DB index, same separation
# convention as the two URLs above. See docs/rate_limiting.md.
RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_URL=redis://localhost:6379/2
RATE_LIMIT_WINDOW_SECONDS=60
# Fail-open (allow the request through, log loudly) by default - the right
# choice for an abuse guard, not a security boundary. Set to false for a
# deployment that would rather reject traffic than run briefly unprotected.
RATE_LIMIT_FAIL_OPEN=true
# No reverse proxy sits in front of this API in any deployment this
# project ships - leave false unless one that sets X-Forwarded-For itself
# is guaranteed to be there (see docs/rate_limiting.md).
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_EXPENSIVE_PER_WINDOW=15
RATE_LIMIT_KNOWLEDGE_PER_WINDOW=20
RATE_LIMIT_DEFAULT_PER_WINDOW=120

# --- LLM provider (Phase 4) ---
# IMPORTANT: a Claude.ai Pro/Max chat subscription does NOT include API
# access. ANTHROPIC_API_KEY must come from a separate Anthropic Console
# account (console.anthropic.com) with its own billing. The same applies to
# OPENAI_API_KEY and a ChatGPT Plus subscription. "local_dev" (the default)
# means no LLM call is ever made - POST /conversations/{id}/ask still runs
# the full retrieval pipeline and honestly reports
# generation.grounding_status="unavailable" rather than fabricating an
# answer. Set LLM_PROVIDER=anthropic or openai and the matching key below to
# enable real generation. See docs/rag.md.
LLM_PROVIDER=local_dev
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave unset to talk to OpenAI itself (openai-python's own default
# endpoint). Set to point OpenAiLlmProvider at any other
# OpenAI-Chat-Completions-compatible host instead - e.g. a genuinely free
# Groq API key (console.groq.com) with
# OPENAI_BASE_URL=https://api.groq.com/openai/v1 and
# OPENAI_MODEL=openai/gpt-oss-120b (verified against the real, current
# `GET /v1/models` list for a real Groq key - check that list yourself
# before relying on a specific model name, Groq's free-tier lineup changes).
# Not secret - only the API key is.
OPENAI_BASE_URL=
LLM_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
LLM_LOCAL_DEV_MODEL=
LLM_MAX_OUTPUT_TOKENS=1024
# Only ever true in ENV=test (enforced by Settings validation) - selects a
# deterministic mock provider so the RAG pipeline can be tested without a
# real key. Never set this outside tests.
MOCK_LLM=false
# Approximate context-window budgeting for context_assembler.py - not a real
# tokenizer count (Anthropic ships none offline), never used for billing.
CONTEXT_TOKEN_BUDGET=3000
CHARS_PER_TOKEN_ESTIMATE=4

# --- Audio ingestion ---
SUPPORTED_AUDIO_EXTENSIONS=["wav","mp3","m4a","ogg","webm"]
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=600

# --- Speech-to-text (faster-whisper) ---
# Model weights download from the non-gated Systran/faster-whisper-<size>
# HF repos on first use - no token required. See docs/audio.md.
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5

# --- Speaker diarization (pyannote.audio) ---
# GATED model - requires a free Hugging Face account that has accepted the
# license terms for BOTH pyannote/speaker-diarization-3.1 AND
# pyannote/segmentation-3.0, plus a read-scoped access token below. Without
# this, diarization is skipped gracefully (transcription still succeeds;
# AudioProcessingJob.diarization_status = "unavailable"). See docs/audio.md.
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# --- Emotion intelligence (Phase 3) ---
# facebook/wav2vec2-base is NOT gated - no token required, unlike diarization.
WAV2VEC2_MODEL=facebook/wav2vec2-base
WAV2VEC2_DEVICE=cpu
WAV2VEC2_POOLING=mean
# StorageBackend key prefix for saved classifier checkpoints - not a filesystem path.
EMOTION_MODEL_ARTIFACT_ROOT=models/emotion

# --- Emotion2Vec+ production model ---
# Requires the `funasr` package - not loadable via plain transformers. See docs/emotion.md.
EMOTION2VEC_MODEL=emotion2vec/emotion2vec_plus_base
EMOTION2VEC_HUB=hf
EMOTION2VEC_DEVICE=cpu

# --- NLP (Phase 4) ---
# Neither model is gated - no token required. See docs/nlp.md.
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
NER_MODEL=dslim/bert-base-NER
NLP_DEVICE=cpu

# --- Knowledge ingestion / embeddings / retrieval (Phase 4) ---
# None of these models are gated - no token required. See docs/rag.md.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
MAX_DOCUMENT_UPLOAD_BYTES=10485760
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
HYBRID_RRF_K=60
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Memory (Phase 4) ---
MEMORY_RECENT_TURNS=8
SUMMARY_TRIGGER_MESSAGE_COUNT=12

# --- Text-to-speech / real-time voice loop (Phase 5) ---
# Unlike LLM_PROVIDER, this defaults to a real, always-available local model
# (facebook/mms-tts-eng, not gated, no API key needed) so the full voice
# loop works out of the box. Set to "openai" + OPENAI_API_KEY above for the
# real cloud alternative, or "disabled" to turn TTS off. See docs/voice.md.
TTS_PROVIDER=local_hf
TTS_LOCAL_MODEL=facebook/mms-tts-eng
TTS_DEVICE=cpu
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
VOICE_TURN_MAX_ANSWER_CHARS=2000
