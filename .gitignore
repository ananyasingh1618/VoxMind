# Python
apps/api/.venv/
apps/api/__pycache__/
apps/api/**/__pycache__/
apps/api/.pytest_cache/
apps/api/.ruff_cache/
apps/api/*.egg-info/
apps/api/.data/
# Real gap found during final production-freeze verification: mypy's cache
# (a large binary cache.db) was never excluded anywhere, at either the repo
# root or apps/api - would have been accidentally committed by a broad
# `git add .`. Excluded everywhere it can appear, not just where it
# happened to be found.
.mypy_cache/
**/.mypy_cache/

# Node
apps/web/node_modules/
apps/web/dist/
apps/web/.vite/

# Env
.env
apps/api/.env
apps/web/.env

# OS
.DS_Store

# ML artifacts (Phase 3+)
ml/models/*.ckpt
ml/models/*.pt
ml/datasets/manifests/
apps/api/mlruns/
# Real gap found during final production-freeze verification: ml/'s own
# generated bytecode caches (ml/datasets/__pycache__, ml/training/__pycache__,
# etc.) were never excluded - only apps/api/ and tests/ml/ were.
ml/**/__pycache__/
# A real, genuinely-generated Redis RDB persistence snapshot found sitting
# in apps/api/ (created by a local `redis-server` run from that directory
# at some point during development) - local runtime state, never meant to
# be committed, not previously excluded by any pattern.
apps/api/dump.rdb
**/dump.rdb
# Real gap found during final production-freeze verification: a root-level
# mlruns/ directory (MLflow tracking data, distinct from apps/api/mlruns/
# above) existed and was not covered by any existing pattern.
mlruns/
.pytest_cache/
.ruff_cache/
tests/ml/__pycache__/

# Editor
.vscode/
.idea/

# Local Claude Code tool state - machine-local, not project source.
.claude/
